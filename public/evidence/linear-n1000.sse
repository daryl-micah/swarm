data: [{"name":"AI-Native Early-Stage Startups","weight":18,"painPoints":["Scattered product ops across Slack, docs, and vague weekly calls with no evidence of progress","No dedicated PMs — CEO/board write tickets that lack context, organization, and information","Need AI to draft PRDs and push PRs from day one without configuration overhead","Blocked by legacy tool learning curves when team has zero Jira/Asana experience"],"budget":[50,400]},{"name":"Product-Led Scale-Ups (20-100)","weight":15,"painPoints":["Intake flood from Slack/GitHub/customer feedback buries release-blocking reviews in noise","Recurring workflows (triage, sprint planning, retros) still run manually via calendar invites","Stakeholder/observer access costs extra on Jira/ClickUp — need free unlimited viewers","Custom workflow flexibility gap: Linear opinionated, ClickUp overwhelming, Jira rigid"],"budget":[200,1500]},{"name":"Engineering-First Organizations (100-500)","weight":14,"painPoints":["Vehicle-state sync blocks iOS render — need performance-obsessed tooling that ships fast","Agent coding sessions (setup, run, test) must reduce handoffs; current AI skills inflexible","Self-hosting/data sovereignty required for compliance; Plane too immature, Jira too heavy","Duplicate ride requests, ETA fluctuations, latency in autonomy stacks need automated regression loops"],"budget":[800,8000]},{"name":"Cross-Functional Product Companies (Eng + Design + Marketing + Ops)","weight":12,"painPoints":["Work isn't ticket-shaped — creative/strategy teams need visual planning canvas (Storyflow gap)","Marketing/ops forced into engineering issue trackers; Linear too dev-centric, ClickUp too generic","Priority inbox must separate release-blocking reviews from FYI noise across functions","Loops for recurring agent workflows must span non-engineering domains (content, campaigns, hiring)"],"budget":[500,6000]},{"name":"Jira/Linear Migrators Seeking Speed + AI","weight":11,"painPoints":["Jira's deep agile machinery creates configuration overhead; Linear's opinionated speed hits walls","Need GitHub-deep integrations + AI agents that draft PRDs → push PRs → run tests","Plane offers self-hosting but lacks automations/analytics/integrations maturity","Shortcut/Height close but observer pricing (5 read-only per seat) doesn't scale"],"budget":[600,10000]},{"name":"Enterprise Platform Teams (Compliance + Scale)","weight":9,"painPoints":["Vendor lock-in risk with cloud-only tools; need self-hosted option with enterprise SSO/SCIM","Audit trails for agent actions (who approved what, when) required for SOC2/ISO","Custom workflow engine must support regulated release gates without brittle scripting","Pricing predictability: per-seat enterprise tiers vs. custom quotes that stall procurement"],"budget":[5000,50000]},{"name":"Agencies & Consultancies (Multi-Client Project Portfolio)","weight":7,"painPoints":["Client workspaces need strict isolation; Linear workspaces not designed for agency multi-tenancy","Observer/stakeholder licenses per client add up — Jira free unlimited viewers wins here","Recurring client reporting loops (status, burndown, retro) must run agent-automated","Intake from client Slack/email must auto-route to right project without manual triage"],"budget":[1000,12000]},{"name":"Open-Source & Community-Driven Projects","weight":6,"painPoints":["Plane is closest self-hosted alternative but community smaller, automations developing","Need public issue tracker + private security issues + contributor onboarding loops","GitHub Projects too lightweight; Jira too heavy; Linear cloud-only blocks data sovereignty","Agent triage for first-time contributor PRs (label, route, suggest reviewers) missing"],"budget":[0,200]},{"name":"Founder-Led Teams with No PM Function","weight":5,"painPoints":["CEO/board communicate via messages/emails → create 'disgusting tickets' lacking context","AI skill to create tickets/bugs/PRDs not flexible enough; agent can't organize unstructured input","Need intake that turns messy conversations into actionable, labeled, prioritized issues instantly","Priority inbox must surface what blocks revenue/launch vs. what can wait"],"budget":[100,800]},{"name":"High-Velocity Shipping Teams (Performance-Obsessed)","weight":4,"painPoints":["Startup render blocked on full vehicle_state sync — need tooling that models same philosophy","Loops must run nightly perf regression, auto-bisect, and file PRs with reproductions","Priority inbox latency: review blocking release buried under 50+ daily notifications","Coding sessions must set up, run, test in CI-like environment before human review"],"budget":[400,5000]},{"name":"Data-Sovereignty / Self-Hosting Mandates","weight":3,"painPoints":["Linear cloud-only; Plane self-hosted but automations/analytics/integrations immature","Jira Data Center expensive; GitHub Enterprise lacks product-layer (loops, intake, priority)","Need agent workflows (coding sessions, triage loops) running on-prem/air-gapped","Customization freedom to modify core workflows without vendor dependency"],"budget":[2000,30000]},{"name":"Stakeholder-Heavy Orgs (Execs, Sales, Support, Customers)","weight":2,"painPoints":["Jira free unlimited stakeholder licenses; Linear/Shortcut charge per observer seat","Sales/support need read-only roadmap visibility without edit noise","Customer-facing portal for public issues + status updates must be zero-config","Priority inbox for stakeholders: only show 'needs your decision' items, hide eng noise"],"budget":[300,4000]}]

