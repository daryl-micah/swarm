event: segments
data: [{"name":"AI-Native Startup Founders","weight":0.12,"painPoints":["Scattered product ops across chats, docs, vague weekly calls","Need evidence of progress not just feeling of busy","Agents installed but not managed like direct reports","No system for designing agent roles, structured feedback, evolving agent files"],"budget":[200,800]},{"name":"Series A/B Engineering-Led Companies","weight":0.18,"painPoints":["Jira too heavy, ClickUp too generic, Linear learning curve for new hires","Vocabulary (issues, cycles, triage) alienates PMs/designers","Marketing/sales/ops find tool too developer-focused","Tasks and emails remain separate - communication not managed"],"budget":[800,3000]},{"name":"Mid-Market Product-Led Orgs (100-500)","weight":0.15,"painPoints":["Cross-functional teams juggling marketing, ops, design alongside code","Linear great for engineering but creative/product-strategy work not ticket-shaped","Need visual planning canvas alongside issue tracking","Stakeholder visibility limited - read-only seats cost extra"],"budget":[3000,8000]},{"name":"Enterprise Platform Teams (500-2000)","weight":0.14,"painPoints":["Deep agile machinery needed but Linear opinionated speed preferred","Customizable enterprise tracking vs. Linear's constraints","Self-hosting/data residency requirements","Agent governance at scale - 75%+ workspaces have agents but no management framework"],"budget":[8000,25000]},{"name":"Open Source / Self-Host Advocates","weight":0.08,"painPoints":["Linear cloud-only, no self-hosted option","Plane offers self-hosting but less AI depth","Need control over data and deployment","Community contributors need free/low-cost access"],"budget":[0,500]},{"name":"Design-Heavy Product Teams","weight":0.07,"painPoints":["Linear UI inconsistencies, TypeError bugs affect design workflows","Design work not ticket-shaped - needs visual canvas","Handoffs between design and engineering create friction","Launch page assets, UI flicker, startup delays block design validation"],"budget":[500,2000]},{"name":"AI Agent Operations Leads","weight":0.06,"painPoints":["Agents treated as one-off tools not direct reports","No system for coding sessions - triage, investigate, write fix, open PR","Loops for recurring agent workflows need more triggers","Agent work not reviewable/governable in current tools"],"budget":[1000,5000]},{"name":"Performance-Obsessed Mobile Teams","weight":0.05,"painPoints":["iOS app blocks initial render on full vehicle_state sync","Startup timing not tracked - unknown how often users hit delays","UI flicker during autonomy events, ETA fluctuations","Need render-before-sync architecture, background loading"],"budget":[2000,10000]},{"name":"Legacy Jira/Asana Migrators","weight":0.08,"painPoints":["Years of Jira workflows, custom fields, complex permissions","Migration path unclear - data fidelity, link preservation","Team resistance to opinionated Linear workflows","Stakeholder licenses free in Jira, paid in Linear alternatives"],"budget":[5000,20000]},{"name":"Developer Experience / Platform Engineers","weight":0.06,"painPoints":["GraphQL API cleanup, deprecated APIs slowing integrations","Coding sessions need local env setup, run, test before PR","TypeError bugs, contentData bloat in API","Reduce latency in autonomy streams, fallback messaging"],"budget":[1000,4000]},{"name":"Product Ops / Program Managers","weight":0.05,"painPoints":["Priority inbox mixes blocking reviews with FYI notifications","No recurring workflows (Loops) for standing ceremonies","Release tracking across cycles manual","Customer feedback → actionable issues routing inconsistent"],"budget":[800,3000]},{"name":"VC-Backed High-Velocity Scale-Ups","weight":0.06,"painPoints":["Shipping velocity drops as team grows past 50 engineers","Noise reduction fails - too many notifications, unclear priorities","Cycle planning (Cycle 144 etc) becomes ceremonial not functional","Agent adoption uneven across squads - no standardized onboarding"],"budget":[4000,15000]}]

