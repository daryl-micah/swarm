7,"painPoints":["GA4 forces consent banner for any personal data processing","Data transfers to US violate Schrems II / GDPR","No contractual guarantee data stays on EU-owned infrastructure","Legal team spends hours reviewing GA DPA amendments"],"budget":[19,79]},{"name":"Developer / Self-Hosting Advocate","weight":6,"painPoints":["Cloud vendor lock-in for analytics data","Need ClickHouse/PostgreSQL raw access for custom modeling","Open-source auditability for security review","Single-pageviews","CI/CD integration for analytics schema changes"],"budget":[0,49]},{"name":"Enterprise / High-Scale Property (100M+ pv/mo)","weight":5,"painPoints":["GA4 sampling distorts high-cardinality dimensions","99.99% uptime SLA required for board reporting","SSO/SCIM provisioning for 100+ seat team","Data residency proof for sector regulators (finance, health)"],"budget":[299,999]},{"name":"Non-Profit / Public Sector / Education","weight":6,"painPoints":["Surveillance capitalism model conflicts with mission","Budget excludes per-seat enterprise contracts","Need public dashboard sharing for transparency mandates","Cookie banner creates accessibility barrier for constituents"],"budget":[9,39]},{"name":"Web Freelancer / Small Agency (White-Label)","weight":7,"painPoints":["Client onboarding one-by-one in GA4 is tedious","No branded report delivery (email/Slack) for retainer value","Cannot grant client dashboard access without full GA account","Script weight hurts client Core Web Vitals scores"],"budget":[19,69]},{"name":"Product-Led Growth Team (PLG)","weight":5,"painPoints":["User journey exploration requires BigQuery export in GA4","Codeless event capture for in-app milestones missing","Revenue attribution to self-serve signup flow is manual","Funnel steps change weekly; GA4 modifications need admin"],"budget":[49,149]}]

