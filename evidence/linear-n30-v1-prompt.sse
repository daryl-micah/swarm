data: [{"name":"AI-Native Startup Founders","weight":0.12,"painPoints":["Generic project tools (Asana, Trello, ClickUp) don't model product development workflows","No native support for AI agent workflows — agents treated as afterthought","Customer feedback from Slack/discord gets lost, not routed to backlog","Context switching between issue tracker, docs, and code review kills velocity"],"budget":[200,1500]},{"name":"Series A/B Product-Led Companies","weight":0.15,"painPoints":["Roadmap, backlog, and release plans live in disconnected tools","Jira too heavy; Linear's speed matters but need confidence in scale","Engineering complains about noise — too many notifications, unclear priorities","Struggle to turn support tickets and sales calls into prioritized issues"],"budget":[1000,5000]},{"name":"High-Velocity Engineering Teams (50-200 eng)","weight":0.14,"painPoints":["Jira/Linear migration friction — historical data, muscle memory, integrations","Cycle/iteration planning disconnected from actual issue work","Code review and issue tracking separate, causing handoff delays","Mobile/app startup performance issues block dogfooding"],"budget":[3000,12000]},{"name":"Platform Teams Building AI Products","weight":0.1,"painPoints":["No tool models workflows shared by humans AND agents (drafting PRDs, pushing PRs)","Agent loops (recurring workflows) require custom automation elsewhere","Eval/observability for agent output disconnected from issue tracker","Need intake that routes LLM-generated insights to right team automatically"],"budget":[5000,25000]},{"name":"Enterprise Product Orgs Modernizing from Jira","weight":0.13,"painPoints":["Jira's bloat slows teams; leadership mandates consolidation but teams resist","Compliance/audit requirements need structured history Linear may lack","Multi-team dependency tracking across cycles is opaque","Procurement needs SOC2, SSO, data residency — eval overhead high"],"budget":[15000,75000]},{"name":"Developer-Tools & Infra Companies","weight":0.08,"painPoints":["Dogfooding their own product dev tool creates recursive friction","API-first workflows need deep GitHub/GitLab/Figma integration parity","Public issue tracking + internal cycles need clean separation","Changelog/release notes generation from cycles is manual"],"budget":[2000,10000]},{"name":"Design-Led Product Teams","weight":0.07,"painPoints":["Figma → issue handoff loses design context (specs, prototypes, annotations)","Design review cycles not modeled — issues are dev-centric","UI inconsistency bugs (flicker, startup delay) hard to track visually","No shared vocabulary between design cycles and engineering cycles"],"budget":[1500,8000]},{"name":"Remote-First Async Culture Companies","weight":0.06,"painPoints":["Slack/Linear thread integration critical — decisions happen in chat","Timezone-spread teams need async cycle rituals (not meetings)","Notification noise destroys deep work blocks","Intake from async customer calls (Gong, Zoom) must auto-create issues"],"budget":[2000,15000]},{"name":"Mobile/App-First Product Teams","weight":0.05,"painPoints":["iOS/Android startup performance issues invisible in web-centric tools","Vehicle_state / device sync blocking patterns need specialized tracking","App store release cycles (TestFlight, Play Console) not modeled","Crash/ANR data from Sentry/DataDog disconnected from backlog"],"budget":[3000,20000]},{"name":"PLG Companies with High Feedback Volume","weight":0.05,"painPoints":["Thousands of Intercom/Zendesk/Slack threads — manual triage impossible","Linear's intake auto-labeling/routing unproven at their scale","Feedback → issue → roadmap traceability broken","Need public portal for users to see status without Jira license"],"budget":[5000,30000]},{"name":"Agencies / Consultancies Managing Client Products","weight":0.03,"painPoints":["Multi-tenant workspaces needed — client data isolation mandatory","Client-facing boards vs internal cycles permission model complex","Time-tracking/billing integration missing from Linear","Rapid onboarding/offboarding of contractors per engagement"],"budget":[1000,6000]},{"name":"Open Source / Community-Driven Projects","weight":0.02,"painPoints":["Public issue intake from GitHub Issues/Discord needs auto-merge","Contributor onboarding — Linear's learning curve steep for drive-by PRs","No public roadmap/changelog view from cycles","Budget near zero — need generous free tier or OSS program"],"budget":[0,500]}]

